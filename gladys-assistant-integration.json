  "actions": [
    {
      "key": "test_connection",
      "timeout_seconds": 60,
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Signs in to OilFox and reads the sensors of the account.",
        "fr": "Se connecte à OilFox et lit les capteurs du compte.",
        "de": "Meldet sich bei OilFox an und liest die Sensoren des Kontos.",
        "es": "Se conecta a OilFox y lee los sensores de la cuenta."
      }
    },
    {
      "key": "diagnostic",
      "timeout_seconds": 10,
      "label": {
        "en": "Diagnostic",
        "fr": "Diagnostic",
        "de": "Diagnose",
        "es": "Diagnóstico"
      },
      "description": {
        "en": "Writes what the integration knows to its logs (no password, no token), for an issue.",
        "fr": "Écrit ce que sait l’intégration dans ses journaux (sans mot de passe ni jeton), pour un ticket.",
        "de": "Schreibt, was die Integration weiß, in ihre Logs (ohne Passwort und Token), für ein Ticket.",
        "es": "Escribe lo que sabe la integración en sus registros (sin contraseña ni token), para una incidencia."
      }
    }
  ],
