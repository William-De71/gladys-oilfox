{
  "manifest_version": 1,
  "type": "device",
  "name": "OilFox",
  "description": {
    "en": "OilFox tank sensors via the official API: fill level, quantity, days of reach, refills.",
    "fr": "Capteurs de cuve OilFox par l’API officielle : niveau, quantité, autonomie, remplissages.",
    "de": "OilFox-Tanksensoren über die offizielle API: Füllstand, Menge, Reichweite, Befüllungen.",
    "es": "Sensores de depósito OilFox por la API oficial: nivel, cantidad, autonomía, rellenos."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/william-de71/gladys-oilfox:0.1.0",
  "gladys_version": ">=5.3.0",
  "categories": ["energy", "climate"],
  "keywords": [
    "OilFox",
    "FoxInsights",
    "FoxMobile",
    "fioul",
    "Heizöl",
    "heating oil",
    "mazout",
    "cuve",
    "pellets",
    "gasóleo"
  ],
  "cover_image": "https://raw.githubusercontent.com/William-De71/gladys-oilfox/main/cover.jpg",
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "OilFox account",
        "fr": "Compte OilFox",
        "de": "OilFox-Konto",
        "es": "Cuenta OilFox"
      },
      "description": {
        "en": "Enter the e-mail address and the password you use in the FoxMobile app. The integration signs in to the official FoxInsights Customer API (api.oilfox.io) and only reads: the measurements travel through the OilFox cloud. Only your own sensors may be read (fair use policy of FoxInsights). Not affiliated with FoxInsights.",
        "fr": "Saisissez l’adresse e-mail et le mot de passe de l’application FoxMobile. L’intégration se connecte à l’API officielle FoxInsights Customer API (api.oilfox.io) et ne fait que lire : les mesures passent par le cloud OilFox. Seuls vos propres capteurs peuvent être lus (règle d’usage loyal de FoxInsights). Non affiliée à FoxInsights.",
        "de": "Gib die E-Mail-Adresse und das Passwort der FoxMobile-App ein. Die Integration meldet sich bei der offiziellen FoxInsights Customer API (api.oilfox.io) an und liest nur: Die Messwerte laufen über die OilFox-Cloud. Nur deine eigenen Sensoren dürfen gelesen werden (Fair-Use-Regel von FoxInsights). Nicht mit FoxInsights verbunden.",
        "es": "Introduzca la dirección de correo y la contraseña de la aplicación FoxMobile. La integración se conecta a la API oficial FoxInsights Customer API (api.oilfox.io) y solo lee: las mediciones pasan por la nube de OilFox. Solo se pueden leer sus propios sensores (política de uso razonable de FoxInsights). No afiliada a FoxInsights."
      },
      "links": [
        {
          "url": "https://github.com/foxinsights/customer-api",
          "label": {
            "en": "OilFox API documentation",
            "fr": "Documentation de l’API OilFox",
            "de": "Dokumentation der OilFox-API",
            "es": "Documentación de la API OilFox"
          }
        }
      ]
    },
    {
      "key": "email",
      "type": "string",
      "required": true,
      "label": {
        "en": "E-mail address",
        "fr": "Adresse e-mail",
        "de": "E-Mail-Adresse",
        "es": "Dirección de correo"
      },
      "placeholder": {
        "en": "The e-mail of your FoxMobile account",
        "fr": "L’e-mail de votre compte FoxMobile",
        "de": "Die E-Mail deines FoxMobile-Kontos",
        "es": "El correo de su cuenta FoxMobile"
      }
    },
    {
      "key": "password",
      "type": "secret",
      "required": true,
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "placeholder": {
        "en": "The password of your FoxMobile account",
        "fr": "Le mot de passe de votre compte FoxMobile",
        "de": "Das Passwort deines FoxMobile-Kontos",
        "es": "La contraseña de su cuenta FoxMobile"
      }
    },
    {
      "key": "readings",
      "type": "section",
      "label": {
        "en": "Readings",
        "fr": "Lectures",
        "de": "Abfragen",
        "es": "Lecturas"
      },
      "description": {
        "en": "An OilFox measures its tank about once a day. The integration reads the account once an hour (the fair use of FoxInsights), and once more 15 minutes after each planned measurement.",
        "fr": "Un OilFox mesure sa cuve environ une fois par jour. L’intégration lit le compte une fois par heure (l’usage loyal de FoxInsights), et une fois de plus 15 minutes après chaque mesure prévue.",
        "de": "Ein OilFox misst seinen Tank etwa einmal am Tag. Die Integration liest das Konto einmal pro Stunde (Fair Use von FoxInsights) und noch einmal 15 Minuten nach jeder geplanten Messung.",
        "es": "Un OilFox mide su depósito aproximadamente una vez al día. La integración lee la cuenta una vez por hora (el uso razonable de FoxInsights), y una vez más 15 minutos después de cada medición prevista."
      }
    },
    {
      "key": "language",
      "type": "select",
      "default": "auto",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Feature names, measurement state, scene texts and errors. Automatic: the language of the last widget shown.",
        "fr": "Noms des fonctionnalités, état de la mesure, textes des scènes et erreurs. Automatique : la langue du dernier widget affiché.",
        "de": "Namen der Funktionen, Messstatus, Szenentexte und Fehler. Automatisch: die Sprache des zuletzt angezeigten Widgets.",
        "es": "Nombres de las funciones, estado de la medición, textos de escenas y errores. Automático: el idioma del último widget mostrado."
      },
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Automatic",
            "fr": "Automatique",
            "de": "Automatisch",
            "es": "Automático"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "English",
            "de": "English",
            "es": "English"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "Français",
            "fr": "Français",
            "de": "Français",
            "es": "Français"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "Deutsch",
            "fr": "Deutsch",
            "de": "Deutsch",
            "es": "Deutsch"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Español",
            "fr": "Español",
            "de": "Español",
            "es": "Español"
          }
        }
      ]
    }
