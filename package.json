{
  "name": "gladys-oilfox",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for OilFox tank sensors (heating oil, pellets) through the official FoxInsights Customer API: fill level, quantity, days of reach, battery, refill and measurement scene triggers, dashboard widgets. Read only.",
  "homepage": "https://github.com/William-De71/gladys-oilfox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-oilfox.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "oilfox",
    "foxinsights",
    "heating-oil",
    "tank",
    "fill-level",
    "home-automation"
  ]
}
